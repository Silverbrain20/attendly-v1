# Attendly Env Variables

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT Access and Refresh Secrets (Use long random hex strings in production)
JWT_ACCESS_SECRET=attendly-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=attendly-super-secret-refresh-key-minimum-32-chars

# Gmail SMTP Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Attendly <your-email@gmail.com>

# Optional Resend API Config (Fallback)
RESEND_API_KEY=
# EMAIL_FROM=Attendly <noreply@yourdomain.com>

# App Config
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000

