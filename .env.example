# Attendly Environment Variables Template

# Database Connection (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/attendly_db

# JWT Access and Refresh Secrets (must be strong, at least 32 characters)
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_at_least_32_chars

# Supabase Auth & Database Config
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
API_PORT=8000